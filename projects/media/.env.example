# --- Stack/Project Settings ---
COMPOSE_PROJECT_NAME=media
TZ=Europe/Berlin
PUID=1000
PGID=999
# Plex Claim Token: erstellen unter https://www.plex.tv/claim/ (nur einmalig zum Anmelden nötig)
PLEX_CLAIM=REPLACE_ME
# --- Tdarr ---
UMASK=002
TDARR_WEBUI_PORT=8265
TDARR_SERVER_PORT=8266
TDARR_INTERNAL_NODE_PORT=8267
TDARR_EXTRA_NODE_PORT=8268
TDARR_SERVER_IP=0.0.0.0
TDARR_INTERNAL_NODE=true
TDARR_IN_CONTAINER=true
TDARR_NODE_NAME=OviNode
VIRTUAL_HOST=tdarr.meine-domain.de
TDARR_BASE=/opt/docker/tdarr
TDARR_TEMP=/mnt/media/cache
MEDIA_PATH=/mnt/media/video
TDARR_DRI_DEVICE=/dev/dri
# --- Reverse Proxy (Hostname ohne Schema) ---
PLEX_DOMAIN=plex.meine-domain.de
# Nur Zahlen; interner Container-Port
PLEX_PORT=32400
# docker | latest | <version>
PLEX_VERSION=docker
# local | external (Plex Remote Access)
PLEX_NETWORK_ACCESS=external
TAUTULLI_DOMAIN=tautulli.meine-domain.de
CODEX_DOMAIN=codex.meine-domain.de
# Nur Zahlen; interner Container-Port
CODEX_PORT=9810
AUDIOBOOKSHELF_DOMAIN=audiobooks.meine-domain.de
METUBE_DOMAIN=metube.meine-domain.de
CALIBRE_WEB_DOMAIN=calibre.meine-domain.de
# Docker-Mod-Tag; leer lassen um zu deaktivieren (linuxserver/mods:universal-calibre)
CALIBRE_WEB_DOCKER_MODS=linuxserver/mods:universal-calibre
# 1 | 0
CALIBRE_WEB_OAUTHLIB_RELAX_TOKEN_SCOPE=1
