# --- Stack/Project Settings ---
COMPOSE_PROJECT_NAME=n8n
TZ=Europe/Berlin
PUID=1000
PGID=1000

# --- N8N Networking & Proxy ---
N8N_HOST=n8n.islanublar.local
N8N_PORT=5678              # Internal port used by n8n
CERT_NAME=wildcardislanublar.local # Your local wildcard cert

# --- N8N Paths (Bind Mounts) ---
N8N_DATA_PATH=/opt/docker/n8n/data
N8N_DB_DATA_PATH=/opt/docker/n8n/postgres

# --- N8N Secrets (CRITICAL SECURITY) ---
# Used for encrypting credentials and data within n8n.
N8N_ENCRYPTION_KEY=REPLACE_ME

# --- Database Credentials (Replace with Strong Secrets) ---
DB_PASSWORD=REPLACE_ME
DB_USER=n8n_user
DB_NAME=n8n_db
