# Einmalig selbst festlegen/rotieren: openssl rand -base64 48 (self-hosted, kein Anbieter)
FORGEJO_TOKEN=REPLACE_ME
TZ=Europe/Berlin
PUID=1000
PGID=999
# --- Forgejo ---
# Hostname ohne Schema
FORGEJO_DOMAIN=git.meine-domain.de
# MIT Schema, OHNE trailing slash
FORGEJO_ROOT_URL=https://git.meine-domain.de
FORGEJO_PORT=3000
# sqlite3 | mysql | postgres
FORGEJO_DB_TYPE=sqlite3
# true | false
FORGEJO_ACTIONS_ENABLED=true
FORGEJO_DISABLE_REGISTRATION=true
# Interne Service-URL MIT Schema (http://forgejo:3000) - nicht aendern, solange Services/Ports gleich bleiben
FORGEJO_LOCAL_ROOT_URL=http://forgejo:3000
# Der in der Web-UI angezeigte SSH-Port (External Port)
FORGEJO_SSH_PORT=222
# Der im Container laufende SSH-Port
FORGEJO_SSH_LISTEN_PORT=22
# --- Forgejo Runner ---
FORGEJO_RUNNER_NAME=docker-runner
# Komma-getrennte Labels; Docker-Label-Syntax label:docker://image - Achtung: keine Leerzeichen um Kommas, Doppelpunkte Teil der Syntax
FORGEJO_RUNNER_LABELS=docker:docker://node:20,ubuntu-latest:docker://node:20
