# ==============================================
# Docker Compose Project Configuration
# ==============================================

COMPOSE_PROJECT_NAME=paperless

# ==============================================
# Docker Data Path Configuration
# ==============================================

# Base path for all docker volumes
DOCKER_DATA_PATH=/opt/docker
NAS_DATA_PATH=/mnt/paperless
# ==============================================
# System Configuration
# ==============================================

TZ=Europe/Berlin
PUID=1000
PGID=999

# ==============================================
# Nginx Reverse Proxy Configuration
# ==============================================

VIRTUAL_HOST=paperless.islasorna.de
PAPERLESS_AI_VIRTUAL_HOST=paperless-ai.islasorna.de

# ==============================================
# Paperless-ngx Configuration
# ==============================================

# Database Configuration
PAPERLESS_DB_NAME=paperlessdb
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=REPLACE_ME

# Secret Key (Generate with: openssl rand -base64 32)
PAPERLESS_SECRET_KEY=REPLACE_ME

# Admin User Configuration
PAPERLESS_ADMIN_USER=stephan
PAPERLESS_ADMIN_PASSWORD=REPLACE_ME
PAPERLESS_ADMIN_MAIL=REPLACE_ME

# OCR Language Configuration
PAPERLESS_OCR_LANGUAGE=eng+deu
# API Token for Paperless-AI (generate in Paperless UI after first login)
# Go to Settings -> API Tokens and create a new token
PAPERLESS_API_TOKEN=REPLACE_ME

# ==============================================
# Paperless Auto-Tagging & Filename Configuration
# ==============================================

# Auto-matching algorithm (auto, first, best)
PAPERLESS_AUTO_MATCH_ALGORITHM=auto

# Filename format with variables
# Available variables: {title}, {correspondent}, {document_type}, {created}, {created_year}, 
# {created_month}, {created_day}, {added}, {added_year}, {added_month}, {added_day}, 
# {tag_list}, {tags[tag_name]}
PAPERLESS_FILENAME_FORMAT={created_year}/{created_month}/{correspondent}/{title}
PAPERLESS_FILENAME_FORMAT_REMOVE_NONE=true

# Barcode scanning
PAPERLESS_CONSUMER_ENABLE_BARCODES=true
# Enable Machine Learning Features
PAPERLESS_ENABLE_ML=true

# ==============================================
# Paperless-AI Configuration
# ==============================================

PAPERLESS_AI_PORT=3000

# AI Provider (openai, anthropic, ollama)
AI_PROVIDER=openai

# Portkey API Configuration (acts as OpenAI proxy)
PORTKEY_API_KEY=REPLACE_ME
PORTKEY_API_BASE=REPLACE_ME

# OpenAI Model Configuration
OPENAI_MODEL=gpt-4o-mini

# Alternative: Use Claude via Portkey
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_portkey_api_key_here
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Ollama Configuration (if using local AI - not needed for Portkey)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# AI Processing Settings
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=REPLACE_ME

# Automatic Processing
AUTO_PROCESS=true
PROCESS_INTERVAL=300

# AI Features
ENABLE_TAGGING=true
ENABLE_CORRESPONDENT=true
ENABLE_DOCUMENT_TYPE=true
ENABLE_SUMMARY=true

# Logging
LOG_LEVEL=INFO

# ==============================================
# Optional: Tika & Gotenberg
# ==============================================

PAPERLESS_TIKA_ENABLED=true
PAPERLESS_CONSUMER_ENABLE_ASN_BARCODE=false

# ==============================================
# Optional: Additional Paperless Settings
# ==============================================

# Consumer settings
# PAPERLESS_CONSUMER_RECURSIVE=false
# PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=false

# Email settings (for consuming emails)
#PAPERLESS_EMAIL_HOST=smtp.mailbox.org
