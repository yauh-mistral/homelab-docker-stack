# --- Stack/Project Settings ---
COMPOSE_PROJECT_NAME=web-proxy

# --- Nginx Proxy Settings ---
PROXY_TRUST_DOWNSTREAM=true
NGINX_MODIFICATION=location /media/ { root /media/; index index.html index.htm; }

# Paths for host bind mounts (Use absolute paths)
NGINX_BASE_PATH=/opt/docker/nginx
ACME_BASE_PATH=/opt/docker/acme

# --- ACME Companion Settings ---
ACME_DEFAULT_EMAIL=admin@meine-domain.de
# HTTP-01 | DNS-01
ACME_CHALLENGE=DNS-01
ACME_DEBUG=false
#or 1

# (vom Anbieter)
DESEC_TOKEN=REPLACE_ME

# Komma-getrennt, Wildcards mit *., z.B. *.example.com,example.com
# Komma-getrennt, Wildcards mit *. (wird von allen cert-Containern genutzt)
WILDCARD_DOMAINS=*.meine-domain.de,meine-domain.de
# Dummy-Host der cert-Container (duerfen nicht mit echten vhosts kollidieren)
CERT_DUMMY_HOST=dummy.meine-domain.de
# Hauptseite
MAIN_DOMAIN=meine-domain.de
WWW_DOMAIN=www.meine-domain.de
# Nur Zahlen; interner Container-Port der Hauptseite
MAIN_SITE_PORT=80
