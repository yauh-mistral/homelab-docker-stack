# Ghost Configuration
GHOST_WEB_PORT=2368
# Comma-separated hosts WITHOUT scheme (for nginx/proxy matching)
GHOST_DOMAIN=www.meine-domain.de,meine-domain.de
# WITH scheme, WITHOUT trailing slash, only ONE URL (https://www.example.com)
GHOST_URL=https://www.meine-domain.de

# Storage Paths
GHOST_CONTENT_PATH=/opt/docker/ghost/ghost
MYSQL_DATA_PATH=/opt/docker/ghost/mysql

# Database Configuration
MYSQL_USER=ghost_user
# Erzeugen: openssl rand -base64 24
MYSQL_PASSWORD=REPLACE_ME
# Erzeugen: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=REPLACE_ME
GHOST_DB_NAME=ghost_prod
ACTIVITYPUB_DB_NAME=ghost_activitypub
GHOST_MYSQL_PORT=3307

# ActivityPub Configuration
ACTIVITYPUB_WEBHOOK_SECRET=REPLACE_ME

# --- Mail Configuration ---
SMTP_SERVICE=mailboxorg
SMTP_HOST=smtp.mail-provider.example
SMTP_PORT=465
SMTP_USER=user@mail-provider.example
# Provided by the mail provider (webmail/SMTP password) - do NOT generate yourself
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=admin@meine-domain.de

# --- System ---
TZ=Europe/Berlin
# --- Ghost DB (Compose-interne Verbindungsparameter) ---
# mysql | sqlite
GHOST_DB_CLIENT=mysql
# Hostname des DB-Containers im Compose-Netz
GHOST_DB_HOST=ghost-mysql
# Numbers only; internal container port
GHOST_DB_PORT=3306
# --- Mail Transport ---
# SMTP | SMTPAuthorization | Sendmail
GHOST_MAIL_TRANSPORT=SMTP
# --- ActivityPub ---
# true | false
ACTIVITYPUB_ENABLED=true
# Internal service URL WITH scheme, WITHOUT trailing slash (http://activitypub:8080) - do not change as long as services/ports stay the same
ACTIVITYPUB_INTERNAL_URL=http://activitypub:8080
# Path WITHOUT trailing slash, starts with /
ACTIVITYPUB_BASE_PATH=/.ghost/activitypub
ACTIVITYPUB_NODE_ENV=production
# Hostname des MySQL-Containers aus Sicht von activitypub
ACTIVITYPUB_MYSQL_HOST=mysql
# Path WITHOUT trailing slash; container path of the image storage
ACTIVITYPUB_STORAGE_PATH=/opt/activitypub/content/images/activitypub
# Internal Ghost URL WITH scheme (http://ghost:2368) - do not change as long as services/ports stay the same
ACTIVITYPUB_GHOST_URL=http://ghost:2368
# memory | redis
ACTIVITYPUB_QUEUE_DRIVER=memory
