# MIT Schema, OHNE trailing slash (https://vw.example.com)
DOMAIN=https://vw.islasorna.de
VIRTUAL_HOST=vw.islasorna.de
VIRTUAL_PORT=80
SMTP_HOST=smtp.mailbox.org
SMTP_FROM=artie.isaacs@islanublar.de
SMTP_PORT=587
# starttls | force_tls | off
SMTP_SECURITY=starttls
SMTP_USERNAME=herrhochhaus@mailbox.org
# Vom Mail-Provider vorgegeben (Webmail-/SMTP-Passwort) - NICHT selbst generieren
SMTP_PASSWORD=REPLACE_ME
SMTP_TIMEOUT=15            # optional
# Quoted: "Plain" | "Login" | "Xoauth2"
SMTP_AUTH_MECHANISM="Plain"
SMTP_EXPLICIT_TLS=true
SMTP_DEBUG=false
# Einmalig selbst festlegen/rotieren: openssl rand -base64 48 (self-hosted, kein Anbieter)
ADMIN_TOKEN=REPLACE_ME
WEBAUTHN_ENABLED=true
