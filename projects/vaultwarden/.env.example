# WITH scheme, WITHOUT trailing slash (https://vw.example.com)
DOMAIN=https://vw.meine-domain.de
VIRTUAL_HOST=vw.meine-domain.de
VIRTUAL_PORT=80
SMTP_HOST=smtp.mail-provider.example
SMTP_FROM=admin@meine-domain.de
SMTP_PORT=587
# starttls | force_tls | off
SMTP_SECURITY=starttls
SMTP_USER=user@mail-provider.example
# Provided by the mail provider (webmail/SMTP password) - do NOT generate yourself
SMTP_PASSWORD=REPLACE_ME
SMTP_TIMEOUT=15            # optional
# Quoted: "Plain" | "Login" | "Xoauth2"
SMTP_AUTH_MECHANISM="Plain"
SMTP_EXPLICIT_TLS=true
SMTP_DEBUG=false
# Set/rotate once yourself: openssl rand -base64 48 (self-hosted, no provider)
ADMIN_TOKEN=REPLACE_ME
WEBAUTHN_ENABLED=true
