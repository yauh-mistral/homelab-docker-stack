# Upstream API Keys (Optional - only needed if routing to cloud providers)
OPENAI_API_KEY=REPLACE_ME
ANTHROPIC_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME

HERMES_M4PRO_KEY=REPLACE_ME
