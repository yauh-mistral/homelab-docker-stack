# --- Stack/Project Settings ---
COMPOSE_PROJECT_NAME=ai
# Domain Configuration
LITELLM_DOMAIN=litellm.meine-domain.de
# LiteLLM Master Key (Used for Admin UI login & Admin API authentication)
LITELLM_MASTER_KEY=REPLACE_ME
# Admin UI Login Credentials
UI_USER=admin
# Erzeugen: openssl rand -base64 24
UI_PASSWORD=REPLACE_ME
# Database Credentials
POSTGRES_DB=litellm
POSTGRES_USER=litellm
# Erzeugen: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_ME
# Upstream API Keys (Optional - only needed if routing to cloud providers)
OPENAI_API_KEY=REPLACE_ME
# Erstellen beim jeweiligen Anbieter (Konsole/Dashboard) - nicht selbst generieren
ANTHROPIC_API_KEY=REPLACE_ME
# Erstellen beim jeweiligen Anbieter (Konsole/Dashboard) - nicht selbst generieren
OPENROUTER_API_KEY=REPLACE_ME
# Secret - maskiert; Herkunft/Konvention siehe projects/env-details.md
HERMES_M4PRO_KEY=REPLACE_ME
# --- SearXNG ---
SEARXNG_HOSTNAME=searxxng.meine-domain.de
# --- Crawl4AI ---
# Erstellen beim jeweiligen Anbieter (Konsole/Dashboard) - nicht selbst generieren
CRAWL4AI_API_TOKEN=REPLACE_ME
