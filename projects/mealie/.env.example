TZ=Europe/Berlin
PUID=1000
PGID=999

SMTP_HOST=smtp.mail-provider.example
SMTP_PORT=465
SMTP_USER=user@mail-provider.example
# Vom Mail-Provider vorgegeben (Webmail-/SMTP-Passwort) - NICHT selbst generieren
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=admin@meine-domain.de
SMTP_SENDER=admin@meine-domain.de
# --- Mealie App ---
# MIT Schema, OHNE trailing slash
MEALIE_BASE_URL=https://recipes.meine-domain.de
# Hostname ohne Schema
MEALIE_DOMAIN=recipes.meine-domain.de
# postgres | sqlite
MEALIE_DB_ENGINE=postgres
POSTGRES_SERVER=192.168.0.15
# Nur Zahlen
POSTGRES_PORT=5400
POSTGRES_USER=mealieuser
POSTGRES_DB=mealie
# Erzeugen: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_ME
# Erzeugen: openssl rand -hex 32
MEALIE_SECRET_KEY=REPLACE_ME
# Anzeigename des Absenders (frei waehlbar, kein Secret)
MEALIE_SMTP_FROM_NAME=Mealie
# TLS | SSL | NONE
MEALIE_SMTP_AUTH_STRATEGY=TLS
SMTP_SENDER=admin@meine-domain.de
