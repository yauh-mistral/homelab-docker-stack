CASTOPOD_DOMAIN=www.meine-domain.de

# ======================
# Database Configuration
# ======================
MARIADB_ROOT_PASSWORD=REPLACE_ME
MARIADB_DATABASE=castopod
MARIADB_USER=castopod
# Erzeugen: openssl rand -base64 24
MARIADB_PASSWORD=REPLACE_ME

# Database prefix for tables
CP_DATABASE_PREFIX=cp_

# ======================
# Castopod Configuration
# ======================
# Base URL of your Castopod instance (include http:// or https://)
# For local development: http://localhost:8000
# For production: https://podcast.example.com
CP_BASEURL=https://www.meine-domain.de/
CP_ENVIRONMENT=production

# Analytics salt - generate a random string (at least 32 characters)
# You can generate one with: openssl rand -hex 32
CP_ANALYTICS_SALT=REPLACE_ME

# Disable HTTPS requirement (set to 1 for local development, 0 for production with HTTPS)
CP_DISABLE_HTTPS=1

# ======================
# Cache Configuration
# ======================
CP_CACHE_HANDLER=redis

# Redis configuration
CP_REDIS_HOST=redis
CP_REDIS_PORT=6379
# Erzeugen: openssl rand -base64 24
CP_REDIS_PASSWORD=REPLACE_ME
CP_REDIS_DATABASE=0

# ======================
# Email Configuration
# ======================
# SMTP Host (e.g., smtp.gmail.com, smtp.mailgun.org, smtp.sendgrid.net)
CP_EMAIL_SMTP_HOST=smtp.mail-provider.example

# From email address
CP_EMAIL_FROM=admin@meine-domain.de

# SMTP Username
CP_EMAIL_SMTP_USER=user@mail-provider.example

# SMTP Password
CP_EMAIL_SMTP_PASSWORD=REPLACE_ME

# SMTP Port (25, 465, 587, or 2525)
CP_EMAIL_SMTP_PORT=465

# SMTP Encryption (tls, ssl, or leave empty for none)
CP_EMAIL_SMTP_CRYPTO=tls

# ======================
# Media Storage (Local)
# ======================
CP_MEDIA_ROOT=/app/public/media

# Base URL for media files (usually same as CP_BASEURL)
CP_MEDIA_BASE_URL=/app/public/media

# S3 Storage disabled (using local storage)
CP_MEDIA_S3_ENABLED=false

# ======================
# Performance Settings
# ======================
# Request timeout in seconds
CP_TIMEOUT=900

# Maximum request body size (e.g., 512M, 1G)
CP_MAX_BODY_SIZE=512M

# PHP memory limit
CP_PHP_MEMORY_LIMIT=1G

# Maximum upload file size
CP_UPLOAD_MAX_FILESIZE=500M

# Maximum POST size
CP_POST_MAX_SIZE=512M
