COMPOSE_PROJECT_NAME=analytics
TZ=Europe/Berlin
PUID=1000
PGID=999
# Hostname ohne Schema/Port (Subdomain der Shynet-Instanz)
SHYNET_HOST=analytics.meine-domain.de
# Nur Zahlen; interner Host-Port, auf dem der Shynet-Server lauscht
SHYNET_PORT=8011
CERT_EMAIL=admin@meine-domain.de
SHYNET_BASE_PATH=/opt/docker/shynet
SHYNET_DATA_PATH=${SHYNET_BASE_PATH}/data
DB_DATA_PATH=${SHYNET_BASE_PATH}/postgres
# Erzeugen: openssl rand -hex 32
SECRET_KEY=REPLACE_ME
# Erzeugen: openssl rand -hex 32
DB_SECRET_KEY=REPLACE_ME
# Erzeugen: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_USER=shynet_user
POSTGRES_DB=shynet_db
# Komma-getrennte Hostliste OHNE Schema (Django ALLOWED_HOSTS)
ALLOWED_HOSTS=192.168.0.15,localhost,analytics.meine-domain.de,analytics-shynet-server
# Komma-getrennte Origins MIT Schema (https://...), keine trailing slashes
CSRF_TRUSTED_ORIGINS=https://analytics.meine-domain.de,https://192.168.0.15,http://localhost

SMTP_HOST=smtp.mail-provider.example
SMTP_PORT=465
SMTP_USER=user@mail-provider.example
# Vom Mail-Provider vorgegeben (Webmail-/SMTP-Passwort) - NICHT selbst generieren
SMTP_PASSWORD=REPLACE_ME
# Absender-Adresse, nur EINE Adresse ohne Anzeigenamen
SMTP_FROM=admin@meine-domain.de
# Absender-Adresse, nur EINE Adresse ohne Anzeigenamen
SMTP_SENDER=admin@meine-domain.de
