COMPOSE_PROJECT_NAME=analytics
TZ=Europe/Berlin
PUID=1000
PGID=999
SHYNET_HOST=analytics.islanublar.de
SHYNET_PORT=8011
CERT_EMAIL=stephan@yauh.de
SHYNET_BASE_PATH=/opt/docker/shynet
SHYNET_DATA_PATH=${SHYNET_BASE_PATH}/data
DB_DATA_PATH=${SHYNET_BASE_PATH}/postgres
# Erzeugen: openssl rand -hex 32
SECRET_KEY=REPLACE_ME
# Erzeugen: openssl rand -hex 32
DB_SECRET_KEY=REPLACE_ME
# Erzeugen: openssl rand -base64 24
DB_PASSWORD=REPLACE_ME
DB_USER=shynet_user
DB_NAME=shynet_db
ALLOWED_HOSTS=192.168.0.15,localhost,analytics.islanublar.de,analytics-shynet-server
CSRF_TRUSTED_ORIGINS=https://analytics.islanublar.de,https://192.168.0.15,http://localhost

SMTP_HOST=smtp.mailbox.org
SMTP_PORT=465
SMTP_USERNAME=herrhochhaus@mailbox.org
