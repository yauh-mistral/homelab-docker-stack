# --- Stack/Project Settings ---
COMPOSE_PROJECT_NAME=monitoring
TZ=Europe/Berlin
PUID=1000
PGID=999

# --- Dashdot Settings ---
DASHDOT_HOST=dashdot.meine-domain.de
DASHDOT_PORT=3080
DASHDOT_ENABLE_CPU_TEMPS=true

# --- Uptime Kuma Settings ---
KUMA_HOST=status.meine-domain.de
KUMA_PORT=3001
KUMA_BASE_PATH=/opt/docker/uptime-kuma

# --- Grafana Settings ---
GRAFANA_HOST=grafana.meine-domain.de
GRAFANA_PORT=8303
GRAFANA_BASE_PATH=/opt/docker/grafana
GF_SECURITY_ADMIN_USER=admin
# Erzeugen: openssl rand -base64 24
GF_SECURITY_ADMIN_PASSWORD=REPLACE_ME
