# --- Stack/Project Settings ---
COMPOSE_PROJECT_NAME=monitoring
TZ=Europe/Berlin
PUID=1000
PGID=999
# --- Dashdot Settings ---
DASHDOT_HOST=dashdot.meine-domain.de
DASHDOT_PORT=3001
DASHDOT_ENABLE_CPU_TEMPS=true
# --- Uptime Kuma Settings ---
KUMA_HOST=status.meine-domain.de
KUMA_PORT=3001
KUMA_BASE_PATH=/opt/docker/uptime-kuma
# --- Grafana Settings ---
GRAFANA_HOST=grafana.meine-domain.de
GRAFANA_PORT=3000
GRAFANA_BASE_PATH=/opt/docker/grafana
GF_SECURITY_ADMIN_USER=admin
# Erzeugen: openssl rand -base64 24
GF_SECURITY_ADMIN_PASSWORD=REPLACE_ME
# --- Shynet (Analytics) Settings ---
# true | false (boolesch, Django-Syntax)
SHYNET_DJANGO_SECURE_PROXY_SSL_HEADER=True
# Header value pair WITHOUT spaces (Header,Value)
SHYNET_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# true | false (boolesch)
SHYNET_EMAIL_USE_SSL=True
# Hostname without scheme/Port (Subdomain der Shynet-Instanz)
SHYNET_HOST=analytics.meine-domain.de
# Numbers only; internal container port the Shynet server listens on
SHYNET_PORT=8080
CERT_EMAIL=admin@meine-domain.de
SHYNET_BASE_PATH=/opt/docker/shynet
SHYNET_DATA_PATH=${SHYNET_BASE_PATH}/data
DB_DATA_PATH=${SHYNET_BASE_PATH}/postgres
# Erzeugen: openssl rand -hex 32
SECRET_KEY=REPLACE_ME
# Erzeugen: openssl rand -hex 32
DB_SECRET_KEY=REPLACE_ME
# Erzeugen: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_USER=shynet_user
POSTGRES_DB=shynet_db
# Comma-separated host list WITHOUT scheme (Django ALLOWED_HOSTS)
ALLOWED_HOSTS=192.168.0.15,localhost,analytics.meine-domain.de,analytics-shynet-server
# Comma-separated origins WITH scheme (https://...), no trailing slashes
CSRF_TRUSTED_ORIGINS=https://analytics.meine-domain.de,https://192.168.0.15,http://localhost
SMTP_HOST=smtp.mail-provider.example
SMTP_PORT=465
SMTP_USER=user@mail-provider.example
# Provided by the mail provider (webmail/SMTP password) - do NOT generate yourself
SMTP_PASSWORD=REPLACE_ME
# Sender address, ONE address only, without display name
SMTP_FROM=admin@meine-domain.de
# Sender address, ONE address only, without display name
SMTP_SENDER=admin@meine-domain.de
