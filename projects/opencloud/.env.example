## Basic Settings ##
LOG_DRIVER=
INSECURE=true

## Features ##
# Using external proxy (your existing reverse proxy setup)
COMPOSE_FILE=docker-compose.yml:weboffice/collabora.yml

## Traefik Settings ##
# Not using Traefik - you have your own reverse proxy
TRAEFIK_DASHBOARD=false

## OpenCloud Settings ##
OC_DOCKER_IMAGE=opencloudeu/opencloud-rolling
OC_DOCKER_TAG=latest
OC_DOMAIN=cloud.islanublar.de
DEMO_USERS=false
INITIAL_ADMIN_PASSWORD=REPLACE_ME
CHECK_FOR_UPDATES=true
LOG_LEVEL=info
OC_CONFIG_DIR=/opt/docker/opencloud
OC_DATA_DIR=/mnt/opencloud
DEFAULT_LANGUAGE=en

## SMTP Settings ##
SMTP_HOST=smtp.mailbox.org
SMTP_PORT=587
SMTP_SENDER=REPLACE_ME
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_AUTHENTICATION=plain
SMTP_TRANSPORT_ENCRYPTION=starttls
SMTP_INSECURE=false

## Additional Services ##
START_ADDITIONAL_SERVICES="notifications"

## Collabora Settings ##
COLLABORA=:collabora.yml
COLLABORA_DOMAIN=collabora.islanublar.de
WOPISERVER_DOMAIN=wopi.islanublar.de
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=REPLACE_ME
COLLABORA_SSL_ENABLE=false
COLLABORA_SSL_VERIFICATION=false
COLLABORA_HOME_MODE=false

WOPI_JWT_SECRET=REPLACE_ME
## LDAP Settings ##
LDAP_BIND_PASSWORD=REPLACE_ME

## User/Group IDs ##
# Using defaults: 1000:1000
PUID=1000
PGID=999

## Timezone ##
TZ=Europe/Berlin
