# Domain & Proxy Configuration
WANDERER_DOMAIN=wanderer.meine-domain.de
# Numbers only; internal container port
WANDERER_PORT=3000
# WITH scheme, WITHOUT trailing slash (https://wanderer.example.com)
ORIGIN=https://wanderer.meine-domain.de

# Security Keys (Generate strong random strings / hex keys)
MEILI_MASTER_KEY=REPLACE_ME
# true | false
MEILI_NO_ANALYTICS=true
# Erzeugen: openssl rand -hex 32
POCKETBASE_ENCRYPTION_KEY=REPLACE_ME
# Erzeugen: openssl rand -hex 32
POCKETBASE_PROXY_SECRET=REPLACE_ME

# Application Settings
PUBLIC_DISABLE_SIGNUP=false
# Nginx-style Groessenlimit mit Einheit oder "Infinity"
BODY_SIZE_LIMIT=Infinity
# WITH scheme, WITHOUT trailing slash
OVERPASS_API_URL=https://overpass-api.de
# WITH scheme, WITHOUT trailing slash
VALHALLA_URL=https://valhalla1.openstreetmap.de
# WITH scheme, WITHOUT trailing slash
NOMINATIM_URL=https://nominatim.openstreetmap.org
PUBLIC_MAP_MAX_POLYLINES=100
# true | false (boolesch, kleingeschrieben)
PUBLIC_DISABLE_SIGNUP=true

# Optional: Require login to view any content (makes the entire instance private)
PUBLIC_PRIVATE_INSTANCE=true
# --- Compose-interne Ausnahmen (bewusst NICHT in .env) ---
# MEILI_URL=http://search:7700, PUBLIC_POCKETBASE_URL=http://db:8090, UPLOAD_FOLDER=/app/uploads
# are inter-service URLs/container paths and follow Compose service naming; change them in compose.yaml only if services/ports get renamed.
