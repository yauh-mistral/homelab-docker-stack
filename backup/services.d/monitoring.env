# uptime-kuma (kuma.db SQLite, Stop-Fenster) + grafana (interne DB + dashboards)
SVC_NAME=monitoring
SVC_CATEGORY=config_only
SVC_STACK=projects/monitoring
FILE_PATHS=(
  "/opt/docker/uptime-kuma"
  "/opt/docker/grafana/data"
)
FILE_EXCLUDES=( "grafana/logs/" "uptime-kuma/screenshots/" )
STOP_CONTAINERS=( monitoring-kuma monitoring-grafana )
