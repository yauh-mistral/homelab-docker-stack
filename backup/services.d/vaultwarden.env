# vaultwarden — SQLite WAL: Online-Backup via sqlite3 .backup, NIE db.sqlite3 kopieren.
# attachments/sends/rsa_key per Datei-Backup.
SVC_NAME=vaultwarden
SVC_CATEGORY=db_and_files
SVC_STACK=projects/vaultwarden
DB_TYPE=sqlite
DB_CONTAINER=vaultwarden
SQLITE_FILES=(
  "/opt/docker/vaultwarden/db.sqlite3:/data/db.sqlite3"
)
FILE_PATHS=(
  "/opt/docker/vaultwarden"
)
FILE_EXCLUDES=(
  "db.sqlite3*" "tmp/" "icon_cache/"
)
