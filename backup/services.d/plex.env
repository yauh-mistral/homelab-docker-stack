# plex — Konfiguration/DBs in /config; Media ignoriert
SVC_NAME=plex
SVC_CATEGORY=config_only
SVC_STACK=projects/media
FILE_PATHS=(
  "/opt/docker/plex/conf"
)
# Rebuildbar, nicht sichern: Transcodes, Codec-/Index-Caches, Logs.
# Plex baut Transcode/Codecs on-demand und Indices beim Bibliothek-Scan neu.
FILE_EXCLUDES=(
  "Cache/"
  "Codecs/"
  "Transcode/"
  "Logs/"
)
STOP_CONTAINERS=( plex )
