# web-proxy — nginx conf/vhost/certs/htpasswd + acme-State; logs & html statisch ignorieren
SVC_NAME=web-proxy
SVC_CATEGORY=config_only
SVC_STACK=projects/web-proxy
FILE_PATHS=(
  "/opt/docker/nginx/conf"
  "/opt/docker/nginx/vhost"
  "/opt/docker/nginx/certs"
  "/opt/docker/nginx/htpasswd"
  "/opt/docker/acme"
  "/opt/docker/yauh"
)
FILE_EXCLUDES=( "logs/" "conf-bak/" )
