# wanderer — PocketBase-DB + uploads/plugins; Meilisearch-Index rekonstruierbar (ignoriert)
SVC_NAME=wanderer
SVC_CATEGORY=config_only
SVC_STACK=projects/wanderer
FILE_PATHS=(
  "/opt/docker/wanderer/db"
  "/opt/docker/wanderer/uploads"
  "/opt/docker/wanderer/plugins"
)
STOP_CONTAINERS=( wanderer_db wanderer_web )
