# paperless — PostgreSQL-Dump + paperless-ai-Config.
# data/media liegen auf /mnt/paperless (NAS-Mount) — NICHT ins Backup
# (das NAS hat sein eigenes Backup). Restore: DB einspielen, Daten liegen
# weiterhin auf dem NAS-Mount.
SVC_NAME=paperless
SVC_CATEGORY=db_and_files
SVC_STACK=projects/paperless
DB_TYPE=postgres
DB_CONTAINER=paperless-db
DB_USER=paperless
DB_NAME=paperlessdb
DB_DUMP_EXTRA="--clean --if-exists"
FILE_PATHS=(
  "/opt/docker/paperless-ai"
)
