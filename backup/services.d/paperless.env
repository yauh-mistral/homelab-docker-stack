# paperless — PostgreSQL + data/media auf NAS; Redis ist Broker (ignoriert)
SVC_NAME=paperless
SVC_CATEGORY=db_and_files
SVC_STACK=projects/paperless
DB_TYPE=postgres
DB_CONTAINER=paperless-db
DB_USER=paperless
DB_NAME=paperlessdb
DB_DUMP_EXTRA="--clean --if-exists"
FILE_PATHS=(
  "/mnt/paperless/data"
  "/mnt/paperless/media"
  "/opt/docker/paperless-ai"
)
