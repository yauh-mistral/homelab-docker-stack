# 5etools — statische Website aus Forgejo-Repos; keine Nutzdaten auf dem Host.
# Der Container befüllt /opt/docker/5etools selbst aus den Git-Repos (in Forgejo
# gesichert). Backup = nur die Compose-Definition, die im arcane-Repo lebt.
SVC_NAME=dnd
SVC_CATEGORY=config_only
SVC_STACK=projects/dnd
FILE_PATHS=(
  "%STACKS_DIR%/dnd/compose.yaml"
)
