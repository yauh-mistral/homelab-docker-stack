# ghost — MySQL (ghost_prod + ghost_activitypub) + Content-Ordner
SVC_NAME=ghost
SVC_CATEGORY=db_and_files
SVC_STACK=projects/ghost
DB_TYPE=mysql
DB_CONTAINER=ghost-mysql
# Dump als Root: MySQL 9.x fuehrt auch mit --single-transaction --skip-lock-tables
# initial FLUSH TABLES aus, wofuer der App-User das RELOAD-Privileg fehlt (1227).
# Der Dump wurde trotzdem korrekt erzeugt, aber mysqldump beendet sich mit
# Exit != 0 -> FAIL. Root hat RELOAD; App-User-Rechte bleiben unangetastet.
DB_USER=root
DB_NAME=ghost_prod
DB_DUMP_EXTRA="--databases ghost_prod ghost_activitypub --skip-lock-tables"
# Root-Passwort aus der Produktiv-.env des Stacks laden
# %STACKS_DIR% wird aus /etc/backup.conf aufgeloest (STACKS_DIR=...)
ENV_FILE=%STACKS_DIR%/ghost/.env
DB_PASSWORD_VAR=DB_ROOT_PASSWORD
FILE_PATHS=(  "/opt/docker/ghost/ghost")
