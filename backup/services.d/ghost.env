# ghost — MySQL (ghost_prod + ghost_activitypub) + Content-Ordner
SVC_NAME=ghost
SVC_CATEGORY=db_and_files
SVC_STACK=projects/ghost
DB_TYPE=mysql
DB_CONTAINER=ghost-mysql
DB_USER=ghost_user
DB_NAME=ghost_prod
# ActivityPub-Schema in derselben MySQL-Instanz mitdumpen (siehe QUESTIONS.md #9)
DB_DUMP_EXTRA="--databases ghost_prod ghost_activitypub"
# Passwort aus der Produktiv-.env des Stacks laden (Variable DB_PASSWORD)
# %STACKS_DIR% wird aus /etc/backup.conf aufgeloest (STACKS_DIR=...)
ENV_FILE=%STACKS_DIR%/ghost/.env
FILE_PATHS=(
  "/opt/docker/ghost/ghost"
)
