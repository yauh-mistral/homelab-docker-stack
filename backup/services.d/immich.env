# immich — DB-Dump (pg_dumpall). Die Bibliothek liegt auf /mnt/immich (NAS-
# Mount) und wird NIE ins Backup gesichert — das NAS hat sein eigenes Backup.
# Restore: DB einspielen, Bibliothek liegt weiterhin auf dem NAS-Mount.
SVC_NAME=immich
SVC_CATEGORY=db_only
SVC_STACK=projects/immich
DB_TYPE=postgres
DB_CONTAINER=immich_postgres
DB_USER=postgres
DB_NAME=immich
DB_DUMP_ALL=true
