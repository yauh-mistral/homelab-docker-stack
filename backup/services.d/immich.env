# immich — PostgreSQL (pg_dump) ZUERST, dann UPLOAD_LOCATION (Immich-Doku-Reihenfolge)
SVC_NAME=immich
SVC_CATEGORY=db_and_files
SVC_STACK=projects/immich
DB_TYPE=postgres
DB_CONTAINER=immich_postgres
DB_USER=postgres
DB_NAME=immich
DB_DUMP_ALL=true
FILE_PATHS=(
  "/mnt/immich"
)
# Rebuildbar, nicht sichern (Immich-Doku: Thumbnails/encoded video werden beim
# Job-Scan neu erzeugt; Uploads + DB sind die alleinige Quelle der Wahrheit).
# WICHTIG: library/ und upload/ enthalten die ORIGINALE — nur die dokumentierten
# Cache-Pfade exkludieren (encoded-video/, thumbnails/), niemals upload/ selbst.
FILE_EXCLUDES=(
  "encoded-video/"
  "thumbnails/"
  "*/encoded-video/"
  "*/thumbnails/"
)
