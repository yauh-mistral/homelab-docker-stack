# forgejo — forgejo dump (DB+Config) + Repo-Dateien; Runner-State separat
SVC_NAME=forgejo
SVC_CATEGORY=db_and_files
SVC_STACK=projects/forgejo
DB_TYPE=forgejo
DB_CONTAINER=forgejo
FILE_PATHS=(
  "/opt/docker/forgejo/data"
  "/opt/docker/forgejo/runner"
)
FILE_EXCLUDES=(
  "gitea/attachments/*" "tmp/"
)
