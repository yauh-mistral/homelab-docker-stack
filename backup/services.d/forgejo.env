# forgejo — forgejo dump (DB+Config) + Repo-Dateien; Runner-State separat
SVC_NAME=forgejo
SVC_CATEGORY=db_and_files
SVC_STACK=projects/forgejo
DB_TYPE=forgejo
DB_CONTAINER=forgejo
FILE_PATHS=(
  "/opt/docker/forgejo/data"
  "/opt/docker/forgejo/runner"
)
FILE_EXCLUDES=(
  "gitea/attachments/*" "tmp/"
)
# Mirror-Repos NICHT doppelt sichern: Mirrors sind Kopien externer Quellen
# (5etools etc.), dort neu klonbar. Forgejo trennt Mirrors nicht im Pfad —
# die Mirror-Auswahl passiert via 'mirror'-Flag in der DB, nicht im Verzeichnis.
# Praktischer Ansatz: Mirrors einzeln als Exclude-Regel hier ergaenzen, z.B.
#   "git/repositories/stephan/5etools-mirror.git/"
# (pro Mirror eine Zeile, exakter Pfad unter data/git/repositories/)
