# sparkyfitness — PostgreSQL + uploads/backup
SVC_NAME=sparkyfitness
SVC_CATEGORY=db_and_files
SVC_STACK=projects/sparkyfitness
DB_TYPE=postgres
DB_CONTAINER=sparkyfitness-db
DB_USER=sparky
DB_NAME=sparkyfitness_db
DB_DUMP_EXTRA="--clean --if-exists"
FILE_PATHS=(
  "/opt/docker/sparkyfitness/uploads"
)
