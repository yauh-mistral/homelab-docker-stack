# opencloud — Daten liegen auf /mnt/opencloud (NAS-Mount): NICHT ins Backup,
# das NAS hat sein eigenes Backup. Gesichert wird nur die lokale Config
# unter /opt/docker/opencloud (gestoppt für Konsistenz laut Hersteller).
# Restore: Container-Config zurueckspielen, Daten liegen weiterhin auf dem NAS.
SVC_NAME=opencloud
SVC_CATEGORY=config_only
SVC_STACK=projects/opencloud
FILE_PATHS=(
  "/opt/docker/opencloud"
)
FILE_EXCLUDES=( "opencloud_logs/" )
STOP_CONTAINERS=( opencloud )
