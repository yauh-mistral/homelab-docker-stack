# opencloud — kein DB-Server; Dateien+Metadaten im Dateisystem.
# Hersteller: konsistentes Backup nur im gestoppten Zustand.
SVC_NAME=opencloud
SVC_CATEGORY=config_only
SVC_STACK=projects/opencloud
FILE_PATHS=(
  "/mnt/opencloud"
  "/opt/docker/opencloud"
)
FILE_EXCLUDES=( "opencloud_logs/" )
STOP_CONTAINERS=( opencloud )
