# castopod — MariaDB + Podcast-Media; Redis ist Cache (ignoriert)
SVC_NAME=castopod
SVC_CATEGORY=db_and_files
SVC_STACK=projects/castopod
DB_TYPE=mariadb
DB_CONTAINER=castopod_mariadb
DB_USER=castopod
DB_NAME=castopod
ENV_FILE=%STACKS_DIR%/castopod/.env
DB_PASSWORD_VAR=MYSQL_PASSWORD
FILE_PATHS=(
  "/opt/docker/castopod/app/media"
)
