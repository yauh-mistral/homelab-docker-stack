# ghost-mysql.env — Policy-Overlay fuer Container 'ghost-mysql'
# GTID-Purged-Warnung von mysqldump unterdruecken: Der Dump laeuft auf einem
# Nicht-Replications-Host; ein SET @@GLOBAL.gtid_purged im Dump stoert nur
# beim Import auf GTID-aktivierten Servern. Rein kosmetisch fuer den Restore.
DB_DUMP_EXTRA="--set-gtid-purged=OFF"
