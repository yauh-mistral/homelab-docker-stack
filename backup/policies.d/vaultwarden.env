# vaultwarden.env — Policy-Overlay fuer Container "vaultwarden"
# SQLite-WAL: konsistenter Snapshot via .backup, NIE db.sqlite3 kopieren.
SVC_NAME=vaultwarden
DB_TYPE=sqlite
DB_CONTAINER=vaultwarden
SQLITE_FILES=(
  "/opt/docker/vaultwarden/db.sqlite3:/data/db.sqlite3"
)
FILE_EXCLUDES+=( "db.sqlite3*" "icon_cache/" )
STOP_SELF=false
