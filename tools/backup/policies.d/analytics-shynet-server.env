# analytics-shynet-server.env — Policy fuer Container 'analytics-shynet-server' (monitoring)
# Shynet haelt saemtliche Nutzdaten in der Postgres-DB (als analytics-db gesichert).
# Der Bind-Mount /opt/docker/shynet/data ist nur ein leeres Workdir — Datei-Backup
# liefert 0 Dateien und loest nur einen Consistency-Warn aus.
SVC_IGNORE=true
