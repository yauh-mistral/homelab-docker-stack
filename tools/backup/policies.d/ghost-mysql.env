# ghost-mysql.env — policy overlay for container 'ghost-mysql'
# Suppress the gtid-purged warning from mysqldump: the dump runs on a
# non-replication host; a SET @@GLOBAL.gtid_purged in the dump only
# breaks imports on GTID-enabled servers. Purely cosmetic for the restore.
DB_DUMP_EXTRA="--set-gtid-purged=OFF"
