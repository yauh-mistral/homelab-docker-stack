# plex.env — policy for container 'plex'
# Thumbnails/cache/transcodes/logs are rebuildable — do not back up.
# Plug-in Support/Data/ (28G thumbnail blobs), Metadata/ (21G posters/synopses
# fetched from the web) and Media/ (3.2G local thumbnails) are rebuildable via
# library/metadata refresh. Important: Plug-in Support/Databases/ (Plex DB) stays backed up.
# rsync excludes are relative to the transfer root (/opt/docker/plex/conf):
# single-component patterns (Metadata/, Media/) match at any level, multi-level
# paths need **/ as a prefix to also match nested occurrences.
#
# Plex' weekly Optimize creates dated DB copies (com.plexapp.plugins.
# library*.db-YYYY-MM-DD, ~3.5G each per week), DBRepair leaves *-BACKUP-*- and
# dbtmp/ leftovers behind on vacuum/repair. All of that is redundant (own rotation v.0..v13)
# and gets excluded — the live DBs themselves stay backed up.
# The pattern *-20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]* only matches dated copies,
# not com.plexapp.plugins.library.db / .blobs.db themselves.
EXTRA_FILE_EXCLUDES=( "Cache/" "Codecs/" "Transcode/" "**/Plug-in Support/Data/" "Metadata/" "Media/" "dbtmp/" "*-20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]*" )
